# Base de datos. En local, sin valor, se usa file:local.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Firma de las sesiones (JWT). Obligatoria en Vercel, mínimo 32 caracteres.
# Generar con: openssl rand -base64 48
AUTH_SECRET=

# URL pública de la app, para los links de los emails. En Vercel, si falta,
# se usa el dominio de producción del proyecto.
APP_URL=

# Emails. En local, sin RESEND_API_KEY, los links se imprimen en la consola.
RESEND_API_KEY=
# Dominio verificado en Resend; el remitente queda noreply@<dominio>.
RESEND_FROM_DOMAIN=

CRON_SECRET=
